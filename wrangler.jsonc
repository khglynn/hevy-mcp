/**
 * Wrangler config for the Hevy MCP server.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (NOT here — set via `wrangler secret put` / `.dev.vars`):
 *   MCP_INVITE_CODE — required. Generated (`openssl rand -hex 16`), carried in
 *                     the /start?invite= link you send people. The server
 *                     refuses every new connection when it is unset (fail closed).
 *   OWNER_TOKEN     — optional. Unlocks /admin (who is connected, revoke,
 *                     remove). /admin is a 404 when unset. Make it long.
 *   OPERATOR_NAME   — optional. Your name, shown on the connect and privacy
 *                     pages as the person who can technically read keys. Set
 *                     it as a secret so it survives deploys and stays out of
 *                     the public repo; unset, the pages say "the person who
 *                     runs this server".
 *
 * Deploying to your own account: replace the KV namespace id below with the
 * one `wrangler kv namespace create OAUTH_KV` prints, change or drop the
 * custom-domain route, and delete the `migrations` block entirely — it is
 * this deployment's history (a Durable Object that no longer exists) and a
 * fresh Worker does not need it.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hevy-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // global_fetch_strictly_public is one of the two requirements for CIMD (the
  // other is clientIdMetadataDocumentEnabled:true in src/index.ts); it also
  // hardens the provider's outbound fetch against SSRF.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // v1 created the per-session Durable Object; v2 retires it. The server is
  // stateless per request now — the Hevy key lives only inside the OAuth grant.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HevyMCP"] },
    { "tag": "v2", "deleted_classes": ["HevyMCP"] }
  ],
  // wrangler dev uses the first route's hostname for request URLs; pin the
  // local origin so dev pages don't print the production address.
  "dev": { "host": "localhost:8787" },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "f54353b1576f4198badedc122931afb8"
    }
  ],
  // Best-effort brake on POST /approve (per Cloudflare location, approximate).
  // The real gate is the invite code's entropy; this and the KV failure
  // counter in pages.ts just make brute force expensive.
  "ratelimits": [
    { "name": "APPROVE_RL", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ADMIN_RL", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  // The published URL. Cloudflare creates the DNS record on deploy. The
  // workers.dev hostname stays enabled so connectors registered against it
  // keep working (both hostnames are valid OAuth issuers).
  "routes": [{ "pattern": "hevy.kevinhg.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
