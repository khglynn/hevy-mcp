# Supply-chain wait: npm will not install a version published less than 7 days ago.
# Matches the Dependabot cooldown in .github/dependabot.yml (keep the two equal).
# Needs npm 11.10 or newer; older npm silently ignores the line, so package.json `engines` and CI both require it (scripts/check-release-age.mjs proves it works). Existing lockfile versions are untouched.
min-release-age=7
