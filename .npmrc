# Supply-chain wait: when npm picks a version (adding or updating a package), it skips any
# published less than 7 days ago. Keep equal to the Dependabot cooldown in .github/dependabot.yml.
# npm 11.10 and newer honor it; older npm ignores it. `npm ci` (what CI runs) installs
# package-lock.json exactly as written, so the wait guards what enters the lockfile, not CI.
min-release-age=7
