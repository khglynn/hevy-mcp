{
  "name": "hevy-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted MCP server wrapping the Hevy workout API. OAuth-gated (self-issued passphrase), runs on Cloudflare Workers. Connects to both Claude and ChatGPT.",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "hono": "4.13.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.128.0"
  }
}
