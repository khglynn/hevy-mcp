    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "hono": "4.13.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.128.0"
  }
